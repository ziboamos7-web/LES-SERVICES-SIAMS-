<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIAMS Application</title>
  <style>
    /* ---------- CSS Variables & Reset ---------- */
    :root {
      --bg-main: #f4f5f7;
      --surface: #ffffff;
      --ink: #0f0f14;
      --text-mid: #6b7280;
      --border-color: #e5e7eb;
      --green: #10b981;
      --red: #ef4444;
      --radius-md: 8px;
      --radius-lg: 16px;
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-main);
      color: var(--ink);
      padding-bottom: 70px;
    }

    /* ---------- Topbar ---------- */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      background: var(--surface);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .topbar h1 {
      font-size: 20px;
      font-weight: 700;
    }

    .bell-btn {
      background: none;
      border: none;
      position: relative;
      cursor: pointer;
      color: var(--ink);
    }

    .bell-dot {
      position: absolute;
      top: 0;
      right: 0;
      width: 8px;
      height: 8px;
      background: var(--red);
      border-radius: 50%;
    }

    /* ---------- Navigation Bars ---------- */
    .bottom-nav, .courier-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: var(--surface);
      border-top: 1px solid var(--border-color);
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 60;
    }

    .nav-item, .courier-nav-btn {
      background: none;
      border: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      color: var(--text-mid);
      font-size: 11px;
      cursor: pointer;
      width: 25%;
    }

    .nav-item.active, .courier-nav-btn.active {
      color: var(--ink);
      font-weight: 600;
    }

    .nav-icon-wrap, .courier-nav-ico {
      width: 20px;
      height: 20px;
    }

    .nav-icon-wrap svg, .courier-nav-ico svg {
      width: 100%;
      height: 100%;
    }

    /* ---------- Overlay & Sheet ---------- */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      z-index: 70;
      display: none;
    }

    .overlay.show {
      display: block;
    }

    .sheet {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--surface);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      padding: 16px 20px 30px;
      z-index: 80;
      transform: translateY(100%);
      transition: transform 0.3s ease;
    }

    .sheet.show {
      transform: translateY(0);
    }

    .sheet-handle {
      width: 36px;
      height: 4px;
      background: var(--border-color);
      border-radius: 2px;
      margin: 0 auto 16px;
    }

    /* ---------- Modal générique ---------- */
    .modal {
      position: fixed;
      inset: 0;
      z-index: 70;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s ease;
    }

    .modal.show {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-bg {
      position: absolute;
      inset: 0;
      background: rgba(15, 15, 20, .5);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .modal-card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 400px;
      background: #fff;
      border-radius: var(--radius-lg);
      padding: 24px;
      box-shadow: var(--shadow-lg);
      transform: scale(.95);
      transition: transform .2s ease;
    }

    .modal.show .modal-card {
      transform: scale(1);
    }

    .modal-card h3 {
      margin: 0 0 8px;
      font-size: 18px;
      font-weight: 700;
    }

    .modal-card p {
      margin: 0 0 20px;
      font-size: 14px;
      color: var(--text-mid);
      line-height: 1.5;
    }

    .modal-actions {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
    }

    /* ---------- Notification Toast ---------- */
    .toast-container {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 90;
      width: calc(100% - 40px);
      max-width: 440px;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .toast {
      background: var(--ink);
      color: #fff;
      padding: 12px 18px;
      border-radius: var(--radius-md);
      font-size: 13.5px;
      font-weight: 600;
      box-shadow: var(--shadow-md);
      display: flex;
      align-items: center;
      gap: 10px;
      animation: toastIn .25s ease forwards;
      pointer-events: auto;
    }

    .toast.success { background: var(--green); }
    .toast.error { background: var(--red); }

    @keyframes toastIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ---------- Utility classes ---------- */
    .hidden { display: none !important; }
    .text-center { text-align: center; }
    .mt-12 { margin-top: 12px; }
    .mt-16 { margin-top: 16px; }
    .mt-20 { margin-top: 20px; }
    .mb-16 { margin-bottom: 16px; }
    .flex-1 { flex: 1; }
    .w-full { width: 100%; }
  </style>
</head>
<body>

<div id="app">
  <!-- Topbar Admin / Marchand -->
  <header class="topbar" id="admin-topbar">
    <h1 id="topbar-title">Tableau de bord</h1>
    <button class="bell-btn" id="topbar-bell" aria-label="Notifications">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
      <span class="bell-dot" id="bell-dot"></span>
