      </div>
      <span>Accueil</span>
      <span class="nav-indicator"></span>
    </button>
    <button class="nav-item" data-page="orders">
      <div class="nav-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-2z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </div>
      <span>Commandes</span>
      <span class="nav-indicator"></span>
    </button>
    <button class="nav-item" data-page="products">
      <div class="nav-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
      </div>
      <span>Produits</span>
      <span class="nav-indicator"></span>
    </button>
    <button class="nav-item nav-more" data-page="store">
      <div class="nav-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
      </div>
      <span>Boutique</span>
      <span class="nav-indicator"></span>
    </button>
  </nav>

  <!-- Bottom Navigation Bar (Espace Livreur) -->
  <nav class="courier-nav hidden" id="courier-nav">
    <button class="courier-nav-btn active" data-courier-tab="home">
      <div class="courier-nav-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
      </div>
      <span>Accueil</span>
    </button>
    <button class="courier-nav-btn" data-courier-tab="missions">
      <div class="courier-nav-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
      </div>
      <span>Missions</span>
    </button>
    <button class="courier-nav-btn" data-courier-tab="gains">
      <div class="courier-nav-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
      </div>
      <span>Gains</span>
    </button>
    <button class="courier-nav-btn" data-courier-tab="profile">
      <div class="courier-nav-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </div>
      <span>Profil</span>
    </button>
  </nav>
</div>

<!-- Toast Container -->
<div class="toast-container" id="toast-container"></div>

<!-- Generic Overlay / Sheet Structure -->
<div class="overlay" id="global-overlay"></div>
<div class="sheet" id="global-sheet">
  <div class="sheet-handle"></div>
  <div id="sheet-content"></div>
</div>

<!-- App Script -->
<script>
  // Initialisation de l'application SIAMS
  console.log('SIAMS Application initialized.');
</script>
</body>
